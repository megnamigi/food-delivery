PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Leave empty for the local development JSON store. Production requires MongoDB.
MONGODB_URI=
# Required in production; use a long, randomly generated secret.
JWT_SECRET=
# Without SMTP, local development displays verification/reset links in the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Signed uploads from the API; never expose API_SECRET in the frontend.
# Local development uses server/.data/uploads when these are empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
